# Required for live execution (src/agent) — at least one, depending on which backbone(s) you run.
GEMINI_API_KEY=            # Gemini 3.1 Flash Lite
OPENAI_API_KEY=            # GPT-4.1 mini
OPENROUTER_API_KEY=        # Ministral 3 14B (routed via OpenRouter)

# Optional. Every tool that can use these has a documented non-Supabase / non-GEE fallback
# (see docs/tools.md) — live execution works without them, just with a slower or coarser
# fallback data path for elevation/slope, imperviousness, and TWI lookups.
SUPABASE_URL=               # local elevation/slope cache — setup guide: docs/optional_local_cache.md
SUPABASE_KEY=
GEE_PROJECT_ID=             # Google Earth Engine project, for imperviousness/TWI
GOOGLE_APPLICATION_CREDENTIALS=   # path to a GEE service-account JSON key

# Optional. If set, src/config.py routes every Open-Meteo call (rainfall, soil moisture,
# elevation, tide, river discharge — most of the Layer 2 tools) to Open-Meteo's paid
# customer-* endpoints instead of the free public API. Only useful if you have an
# Open-Meteo API subscription and expect to hit the free tier's rate limit from running
# many live assessments; a single event assessment works fine on the free tier.
OPEN_METEO_API_KEY=

# Not required to reproduce any reported number — evaluate_metrics.py, render_traces.py, and
# compute_efficiency.py all run entirely from files already in data/ and traces/.
